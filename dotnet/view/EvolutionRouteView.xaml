<UserControl x:Class="DscsEvolutionPlanner.View.EvolutionRouteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:view="clr-namespace:DscsEvolutionPlanner.View"
             TextElement.Foreground="{DynamicResource TextBrush}"
             TextElement.FontFamily="{DynamicResource UiFont}"
             TextElement.FontSize="13"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

  <!-- 进化线计算器：左＝查询参数，中＝算出的路线链（蛇形排布，可切文本视图）。 -->
  <UserControl.Resources>
    <!-- 路线里的一张卡片：位置与箭头由 view:RouteChain 算，这里只有外观与内容 -->
    <DataTemplate x:Key="RouteCard">
      <Button Style="{DynamicResource CardButton}"
              view:AttachedCommand.ClickCommand="{Binding DataContext.SelectStepCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
              view:AttachedCommand.ClickParameter="{Binding Id}"
              ToolTip="点击查看详情">
        <Border Width="132" CornerRadius="12" Background="White"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                SnapsToDevicePixels="True">
          <Border.Style>
            <Style TargetType="Border">
              <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
                  <Setter Property="Background" Value="#FCFDFF" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Grid>
            <!-- 把内容按圆角剪一下：不剪的话顶上那条起/终色条会从圆角处支棱出去 -->
            <Grid.Clip>
              <RectangleGeometry Rect="0,0,130,2000" RadiusX="11" RadiusY="11" />
            </Grid.Clip>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Height="3" CornerRadius="12,12,0,0"
                    Background="{Binding RoleBarKey, Converter={StaticResource BrushKey}}"
                    Visibility="{Binding HasRoleBar, Converter={StaticResource BoolVisibility}}" />

            <Grid Grid.Row="1" Margin="10,8,10,0">
              <TextBlock Text="{Binding IdText}" FontSize="10.5" FontWeight="SemiBold"
                         Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Left" />
              <ItemsControl ItemsSource="{Binding Badges}" HorizontalAlignment="Right">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border CornerRadius="8" Padding="6,1" Margin="3,0,0,0" BorderThickness="1"
                            Background="{Binding Key, Converter={StaticResource RoleTint}}"
                            BorderBrush="{Binding Key, Converter={StaticResource RoleBorder}}">
                      <TextBlock Text="{Binding Text}" Style="{DynamicResource PillText}"
                                 Foreground="{Binding Key, Converter={StaticResource BrushKey}}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,4,0,10">
              <Grid Width="112" Height="112" HorizontalAlignment="Center">
                <Grid Visibility="{Binding HasImage, Converter={StaticResource BoolVisibility}, ConverterParameter=invert}">
                  <Rectangle RadiusX="9" RadiusY="9" Fill="{DynamicResource PlaceholderFillBrush}"
                             Stroke="{DynamicResource PlaceholderBorderBrush}" StrokeThickness="1"
                             StrokeDashArray="4 3" />
                  <TextBlock Text="?" FontSize="34" FontWeight="Bold"
                             Foreground="{DynamicResource PlaceholderGlyphBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <TextBlock Text="图片待补" FontSize="9.5" Foreground="{DynamicResource FaintBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,7" />
                </Grid>
                <Image Source="{Binding Image}" Stretch="Uniform"
                       Visibility="{Binding HasImage, Converter={StaticResource BoolVisibility}}" />
              </Grid>
              <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                         TextAlignment="Center" TextWrapping="Wrap" MaxHeight="34" Margin="8,8,8,0" />
              <TextBlock Text="{Binding Generation}" FontSize="11"
                         Foreground="{DynamicResource SubtleBrush}" TextAlignment="Center" Margin="8,2,8,0" />

              <!-- 这只数码兽能提供的、本次查询里选中的继承技（技能名 + 学会等级） -->
              <ItemsControl ItemsSource="{Binding Skills}" Margin="4,0,4,2"
                            Visibility="{Binding HasSkills, Converter={StaticResource BoolVisibility}}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border CornerRadius="7" Background="{DynamicResource ViaTintBrush}"
                            BorderBrush="{DynamicResource ViaSoftBrush}" BorderThickness="1"
                            Padding="5,1" Margin="2,4,2,0" ToolTip="{Binding Tip}">
                      <TextBlock Text="{Binding Text}" FontSize="10"
                                 Foreground="{DynamicResource ViaBrush}" VerticalAlignment="Center" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>
        </Border>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{Binding LeftColumnWidth}" MinWidth="{Binding ColumnMinWidth}" />
      <ColumnDefinition Width="6" />
      <ColumnDefinition Width="*" MinWidth="320" />
    </Grid.ColumnDefinitions>

    <!-- ===================== 左：查询参数 ===================== -->
    <Border Grid.Column="0" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,1,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,4,12,14">
        <StackPanel>
          <TextBlock Text="起终点" Style="{DynamicResource SectionText}" Margin="0,10,0,4" />
          <TextBlock Text="起点数码兽（名字 / 别名 / 编号，支持拼音模糊匹配）" Style="{DynamicResource CaptionText}" Margin="0,0,0,3" />
          <view:SuggestBox Height="32" FontSize="13" Text="{Binding StartText, Mode=TwoWay}"
                           SuggestionProvider="{Binding SuggestStart}" />
          <TextBlock Text="{Binding StartHint}" Style="{DynamicResource HintText}"
                     Foreground="{Binding StartHintKey, Converter={StaticResource BrushKey}}" />

          <TextBlock Text="终点模式" Style="{DynamicResource CaptionText}" />
          <StackPanel Orientation="Horizontal">
            <RadioButton Content="指定终点" IsChecked="{Binding ModeSingle}" Margin="0,0,14,0" />
            <RadioButton Content="多终点" IsChecked="{Binding ModeMulti}" Margin="0,0,14,0" />
            <RadioButton Content="任意终点" IsChecked="{Binding ModeAny}" />
          </StackPanel>
          <TextBlock Text="选「多终点」时可填多只任一只作终点；选「任意终点」时需配合下方的途经数码兽或继承技约束。"
                     Style="{DynamicResource HintText}" />

          <TextBlock Text="终点数码兽" Style="{DynamicResource CaptionText}" />
          <view:SuggestBox Height="32" FontSize="13" Text="{Binding EndText, Mode=TwoWay}"
                           IsEnabled="{Binding IsEndEnabled}" SuggestionProvider="{Binding SuggestEnd}" />
          <TextBlock Text="{Binding EndHint}" Style="{DynamicResource HintText}"
                     Foreground="{Binding EndHintKey, Converter={StaticResource BrushKey}}" />

          <TextBox Text="{Binding MultiEndText, UpdateSourceTrigger=PropertyChanged}" Height="54"
                   AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                   IsEnabled="{Binding IsMultiEndEnabled}" Margin="0,6,0,0" />

          <TextBlock Text="途经数码兽（每行一组：组内任一即可，组之间都要满足）" Style="{DynamicResource CaptionText}" />
          <TextBox Text="{Binding ViaText, UpdateSourceTrigger=PropertyChanged}" Height="58"
                   AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                   VerticalScrollBarVisibility="Auto" />

          <TextBlock Text="需沿途收集的继承技（点开多选，可关键字筛选）" Style="{DynamicResource CaptionText}" />
                    <view:SkillPicker Margin="0,1,0,0"
                            Summary="{Binding SkillSummary}"
                            ItemsSource="{Binding VisibleSkills}"
                            FilterText="{Binding SkillFilter, Mode=TwoWay}"
                            SelectAllCommand="{Binding SelectAllVisibleSkillsCommand}"
                            ClearCommand="{Binding ClearSkillsCommand}" />

          <TextBlock Text="排除世代" Style="{DynamicResource CaptionText}" />
          <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" CornerRadius="6"
                  Height="116" Margin="0,1,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,6">
              <ItemsControl ItemsSource="{Binding Generations}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>

          <Grid Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="路径条数" FontSize="12.5" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center" />
              <TextBox Width="58" Height="28" Margin="8,0,0,0" TextAlignment="Center"
                       Text="{Binding K, UpdateSourceTrigger=LostFocus}" />
              <CheckBox Content="翻转显示" IsChecked="{Binding Reverse}" Margin="18,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>

          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="计算路线" Style="{DynamicResource PrimaryButton}" Width="104"
                    Command="{Binding RunCommand}" />
            <Button Content="{Binding ViewButtonText}" Style="{DynamicResource SecondaryButton}" Width="84"
                    Margin="8,0,0,0" Command="{Binding ToggleTextViewCommand}" />
            <Button Content="导出" Style="{DynamicResource SecondaryButton}" Width="58"
                    Margin="8,0,0,0" Command="{Binding ExportCommand}" />
            <Button Content="重置" Style="{DynamicResource GhostButton}" Width="58"
                    Margin="4,0,0,0" Command="{Binding ResetCommand}" />
          </StackPanel>

          <TextBlock Text="图片目录" Style="{DynamicResource SectionText}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Height="28" FontSize="12" Text="{Binding AssetsDirectory, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Content="浏览…" Style="{DynamicResource GhostButton}" Width="66"
                    Margin="6,0,0,0" Command="{Binding BrowseAssetsCommand}" />
          </Grid>
          <TextBlock Text="图片暂时空着：把 {编号}.png 放进该目录即可自动显示；卡片上会画虚线占位框。"
                     Style="{DynamicResource HintText}" />

          <TextBlock Text="数据文件" Style="{DynamicResource SectionText}" />
          <StackPanel Orientation="Horizontal">
            <Button Content="重新加载数据" Style="{DynamicResource SecondaryButton}" Width="140"
                    HorizontalAlignment="Left" Command="{Binding ReloadDataCommand}" />
            <Button Content="选择文件…" Style="{DynamicResource GhostButton}" Width="86" Margin="8,2,0,0"
                    Command="{Binding ChooseDataFileCommand}" />
          </StackPanel>
                    <TextBlock Text="{Binding DataStatus}" Style="{DynamicResource HintText}" Margin="1,7,0,0"
                     Foreground="{Binding DataStatusKey, Converter={StaticResource BrushKey}}" />
         </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- ===================== 中：路线 / 文本视图 ===================== -->
    <Grid Grid.Column="2" Background="{DynamicResource BgBrush}">
      <ScrollViewer Visibility="{Binding ShowRouteList, Converter={StaticResource BoolVisibility}}"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                    Padding="4,6,4,10">
        <ItemsControl ItemsSource="{Binding Routes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="16,10,16,4">
                <StackPanel Margin="0,0,0,10">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{DynamicResource SubtleBrush}"
                               Margin="10,4,0,0" />
                  </StackPanel>
                  <TextBlock Text="{Binding GoalText}" FontSize="11.5" Foreground="{DynamicResource ViaBrush}"
                             TextWrapping="Wrap" Margin="0,5,0,0" MaxWidth="980"
                             Visibility="{Binding HasGoal, Converter={StaticResource BoolVisibility}}" />
                </StackPanel>

                <!-- 蛇形排布：满了换行，换行后反向；行与行之间竖箭头连接（view/Controls/RouteChain.cs） -->
                <view:RouteChain Steps="{Binding Steps}" CardTemplate="{StaticResource RouteCard}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <TextBlock Text="{Binding EmptyHint}" FontSize="14" TextAlignment="Center" TextWrapping="Wrap"
                 MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="{DynamicResource FaintBrush}"
                 Visibility="{Binding ShowEmptyHint, Converter={StaticResource BoolVisibility}}" />

      <TextBox Visibility="{Binding ShowTextOutput, Converter={StaticResource BoolVisibility}}" IsReadOnly="True"
               AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="{DynamicResource NumberFont}"
               FontSize="12.5" BorderThickness="0" Padding="14,10"
               HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
               Text="{Binding TextOutput, Mode=OneWay}" />
    </Grid>

    <GridSplitter Grid.Column="1" Style="{DynamicResource ColumnSplitter}" />
  </Grid>
</UserControl>