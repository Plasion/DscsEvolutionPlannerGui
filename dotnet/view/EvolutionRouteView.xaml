<UserControl x:Class="DscsEvolutionPlanner.View.EvolutionRouteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:view="clr-namespace:DscsEvolutionPlanner.View"
             TextElement.Foreground="{DynamicResource TextBrush}"
             TextElement.FontFamily="{DynamicResource UiFont}"
             TextElement.FontSize="13"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

  <!-- 进化线计算器：左＝查询参数，中＝算出的路线链（蛇形排布，可切文本视图）。 -->
  <UserControl.Resources>
    <!-- 路线里的一张卡片：位置与箭头由 view:RouteChain 算，这里只有外观与内容。
         横向条，和图鉴关系网的节点卡是同一套语言（头像在左、名字与「#编号 · 世代」在右）。 -->
    <DataTemplate x:Key="RouteCard">
      <Button Style="{DynamicResource CardButton}"
              view:AttachedCommand.ClickCommand="{Binding DataContext.SelectStepCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
              view:AttachedCommand.ClickParameter="{Binding Id}"
              ToolTip="点击查看详情">
        <Border Width="208" Height="78" CornerRadius="10" Background="White"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                SnapsToDevicePixels="True">
          <Border.Style>
            <Style TargetType="Border">
              <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
                  <Setter Property="Background" Value="#FCFDFF" />
                  <Setter Property="Effect">
                    <Setter.Value>
                      <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.20" Color="#334155" />
                    </Setter.Value>
                  </Setter>
                </Trigger>
              </Style.Triggers>
            </Style>
          </Border.Style>

          <Grid>
            <!-- 把内容按圆角剪一下：不剪的话左边那条起/终色条会从圆角处支棱出去 -->
            <Grid.Clip>
              <RectangleGeometry Rect="0,0,206,600" RadiusX="9" RadiusY="9" />
            </Grid.Clip>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="4" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 起 / 终 / 途：一条左侧色条 -->
            <Border Grid.Column="0" Background="{Binding RoleBarKey, Converter={StaticResource BrushKey}}"
                    Visibility="{Binding HasRoleBar, Converter={StaticResource BoolVisibility}}" />

            <!-- 头像统一裁进圆角框 -->
            <Border Grid.Column="1" Width="46" Height="46" CornerRadius="9" Margin="7,0,0,0"
                    Background="{DynamicResource PlaceholderFillBrush}"
                    BorderBrush="{DynamicResource PlaceholderBorderBrush}" BorderThickness="1">
              <Border.Clip>
                <RectangleGeometry Rect="0,0,46,46" RadiusX="8" RadiusY="8" />
              </Border.Clip>
              <Grid>
                <TextBlock Text="?" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource PlaceholderGlyphBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image Source="{Binding Image}" Stretch="Uniform" Margin="2"
                       Visibility="{Binding HasImage, Converter={StaticResource BoolVisibility}}" />
              </Grid>
            </Border>

            <Grid Grid.Column="2" Margin="8,6,8,6">
              <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="14" />
                <RowDefinition Height="18" />
              </Grid.RowDefinitions>

              <!-- 名字固定两行高（不省略号，长了就换行），在行内居中——只占一行的名字才不会贴着顶边 -->
              <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Badges}" VerticalAlignment="Center"
                              Margin="4,0,0,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border CornerRadius="7" Padding="5,0" Margin="3,0,0,0" BorderThickness="1"
                              Background="{Binding Key, Converter={StaticResource RoleTint}}"
                              BorderBrush="{Binding Key, Converter={StaticResource RoleBorder}}">
                        <TextBlock Text="{Binding Text}" Style="{DynamicResource PillText}"
                                   Foreground="{Binding Key, Converter={StaticResource BrushKey}}" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>

              <TextBlock Grid.Row="1" Text="{Binding MetaText}" FontSize="10.5"
                         Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Top" />

              <!-- 这一只提供的继承技：只占一行，多了就裁掉（整条路线的汇总在标题下面那行） -->
              <ItemsControl Grid.Row="2" ItemsSource="{Binding Skills}" ClipToBounds="True"
                            Visibility="{Binding HasSkills, Converter={StaticResource BoolVisibility}}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border CornerRadius="7" Background="{DynamicResource ViaTintBrush}"
                            BorderBrush="{DynamicResource ViaSoftBrush}" BorderThickness="1"
                            Padding="5,0" Margin="0,2,4,0" ToolTip="{Binding Tip}">
                      <TextBlock Text="{Binding Text}" FontSize="10"
                                 Foreground="{DynamicResource ViaBrush}" VerticalAlignment="Center" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Grid>
        </Border>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{Binding LeftColumnWidth}" MinWidth="{Binding ColumnMinWidth}" />
      <ColumnDefinition Width="6" />
      <ColumnDefinition Width="*" MinWidth="320" />
    </Grid.ColumnDefinitions>

    <!-- ===================== 左：查询参数（下面固定一条操作栏，参数区自己滚） ===================== -->
    <Border Grid.Column="0" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="16,2,12,14">
          <StackPanel>

          <!-- ===== 起终点 ===== -->
          <TextBlock Text="起终点" Style="{DynamicResource SectionText}" Margin="0,10,0,6" />
          <TextBlock Text="起点数码兽（名字 / 别名 / 编号，支持拼音模糊匹配）"
                     Style="{DynamicResource CaptionText}" Margin="0,0,0,4" />
          <view:SuggestBox Height="32" FontSize="13" Text="{Binding StartText, Mode=TwoWay}"
                           SuggestionProvider="{Binding SuggestStart}" />
          <TextBlock Text="{Binding StartHint}" Style="{DynamicResource HintText}"
                     Foreground="{Binding StartHintKey, Converter={StaticResource BrushKey}}" />

          <TextBlock Text="终点模式" Style="{DynamicResource CaptionText}" />
          <StackPanel Orientation="Horizontal" Margin="0,1,0,2">
            <RadioButton Content="指定终点" IsChecked="{Binding ModeSingle}" Margin="0,0,14,0" />
            <RadioButton Content="多终点" IsChecked="{Binding ModeMulti}" Margin="0,0,14,0" />
            <RadioButton Content="任意终点" IsChecked="{Binding ModeAny}" />
          </StackPanel>
          <TextBlock Text="选「多终点」时可填多只任一只作终点；选「任意终点」时需配合下方的途经数码兽或继承技约束。"
                     Style="{DynamicResource HintText}" />

          <TextBlock Text="终点数码兽" Style="{DynamicResource CaptionText}" />
          <view:SuggestBox Height="32" FontSize="13" Text="{Binding EndText, Mode=TwoWay}"
                           IsEnabled="{Binding IsEndEnabled}" SuggestionProvider="{Binding SuggestEnd}" />
          <TextBlock Text="{Binding EndHint}" Style="{DynamicResource HintText}"
                     Foreground="{Binding EndHintKey, Converter={StaticResource BrushKey}}" />

          <TextBox Text="{Binding MultiEndText, UpdateSourceTrigger=PropertyChanged}" Height="54"
                   AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                   IsEnabled="{Binding IsMultiEndEnabled}" Margin="0,7,0,0" />

          <!-- ===== 约束 ===== -->
          <TextBlock Text="途经数码兽" Style="{DynamicResource SectionText}" />
          <TextBlock Text="每行一组：组内任一即可，组之间都要满足"
                     Style="{DynamicResource CaptionText}" Margin="0,0,0,4" />
          <TextBox Text="{Binding ViaText, UpdateSourceTrigger=PropertyChanged}" Height="54"
                   AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                   VerticalScrollBarVisibility="Auto" />

          <TextBlock Text="需沿途收集的继承技" Style="{DynamicResource SectionText}" />
          <TextBlock Text="点开多选，可关键字筛选" Style="{DynamicResource CaptionText}" Margin="0,0,0,4" />
          <view:SkillPicker
                  Summary="{Binding SkillSummary}"
                  ItemsSource="{Binding VisibleSkills}"
                  FilterText="{Binding SkillFilter, Mode=TwoWay}"
                  SelectAllCommand="{Binding SelectAllVisibleSkillsCommand}"
                  ClearCommand="{Binding ClearSkillsCommand}" />

          <TextBlock Text="排除世代" Style="{DynamicResource SectionText}" />
          <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" CornerRadius="6"
                  Height="108">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,6">
              <ItemsControl ItemsSource="{Binding Generations}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>

          <!-- ===== 选项 ===== -->
          <Border Height="1" Background="{DynamicResource GridBrush}" Margin="0,14,0,12" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="路径条数" FontSize="12.5"
                       Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Height="30" Margin="8,0,10,0" TextAlignment="Center"
                     Text="{Binding K, UpdateSourceTrigger=LostFocus}" />
            <CheckBox Grid.Column="2" Content="翻转显示" IsChecked="{Binding Reverse}"
                      VerticalAlignment="Center" />
          </Grid>

          </StackPanel>
        </ScrollViewer>

        <!-- ===== 操作栏：固定在下沿，不用滚到底才能点「计算路线」 ===== -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,1,0,0"
                Padding="16,11,12,13">
          <StackPanel>
            <!-- 主操作：占满整行、比下面那排高一档 -->
            <Button Content="计算路线" Style="{DynamicResource PrimaryButton}" Height="44" FontSize="15"
                    Command="{Binding RunCommand}" />

            <!-- 次要操作：三等分一行 -->
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Height="34" Content="{Binding ViewButtonText}"
                      Style="{DynamicResource SecondaryButton}" Command="{Binding ToggleTextViewCommand}" />
              <Button Grid.Column="1" Height="34" Content="导出" Margin="8,0,0,0"
                      Style="{DynamicResource SecondaryButton}" Command="{Binding ExportCommand}" />
              <Button Grid.Column="2" Height="34" Content="重置" Margin="8,0,0,0"
                      Style="{DynamicResource GhostButton}" Command="{Binding ResetCommand}" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- ===================== 中：路线 / 文本视图 ===================== -->
    <Grid Grid.Column="2" Background="{DynamicResource BgBrush}">
      <ScrollViewer Visibility="{Binding ShowRouteList, Converter={StaticResource BoolVisibility}}"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                    Padding="4,6,4,10">
        <ItemsControl ItemsSource="{Binding Routes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="16,10,16,4">
                <StackPanel Margin="0,0,0,10">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{DynamicResource SubtleBrush}"
                               Margin="10,4,0,0" />
                  </StackPanel>
                  <TextBlock Text="{Binding GoalText}" FontSize="11.5" Foreground="{DynamicResource ViaBrush}"
                             TextWrapping="Wrap" Margin="0,5,0,0" MaxWidth="980"
                             Visibility="{Binding HasGoal, Converter={StaticResource BoolVisibility}}" />
                </StackPanel>

                <!-- 蛇形排布：满了换行，换行后反向；行与行之间竖箭头连接（view/Controls/RouteChain.cs） -->
                <view:RouteChain Steps="{Binding Steps}" CardTemplate="{StaticResource RouteCard}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <TextBlock Text="{Binding EmptyHint}" FontSize="14" TextAlignment="Center" TextWrapping="Wrap"
                 MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="{DynamicResource FaintBrush}"
                 Visibility="{Binding ShowEmptyHint, Converter={StaticResource BoolVisibility}}" />

      <TextBox Visibility="{Binding ShowTextOutput, Converter={StaticResource BoolVisibility}}" IsReadOnly="True"
               AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="{DynamicResource NumberFont}"
               FontSize="12.5" BorderThickness="0" Padding="14,10"
               HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
               Text="{Binding TextOutput, Mode=OneWay}" />
    </Grid>

    <GridSplitter Grid.Column="1" Style="{DynamicResource ColumnSplitter}" />
  </Grid>
</UserControl>